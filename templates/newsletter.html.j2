<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html xmlns="http://www.w3.org/1999/xhtml">
<head>
  <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{{ title }}</title>
  <style type="text/css">
    body {
      margin: 0;
      padding: 0;
      min-width: 100%;
      background-color: #f8fafc;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      -webkit-font-smoothing: antialiased;
      color: #1e293b;
    }
    table {
      border-collapse: collapse;
      mso-table-lspace: 0pt;
      mso-table-rspace: 0pt;
    }
    td, tr {
      padding: 0;
    }
    a {
      color: #2563eb;
      text-decoration: none;
    }
    @media only screen and (max-width: 620px) {
      .main-card {
        width: 100% !important;
        border-radius: 0 !important;
        border-left: none !important;
        border-right: none !important;
      }
      .content-pad {
        padding: 20px 16px !important;
      }
      .metric-cell {
        display: block !important;
        width: 100% !important;
        border-left: none !important;
        border-right: none !important;
        border-bottom: 1px solid #f1f5f9 !important;
        padding: 8px 0 !important;
      }
    }
  </style>
</head>
<body style="margin: 0; padding: 0; background-color: #f8fafc; color: #1e293b;">

  <!-- Outer Canvas Table -->
  <table width="100%" border="0" cellpadding="0" cellspacing="0" bgcolor="#f8fafc" style="background-color: #f8fafc; table-layout: fixed;">
    <tr>
      <td align="center" style="padding: 32px 8px 48px 8px;">

        <!-- Main Card Container -->
        <table class="main-card" width="600" border="0" cellpadding="0" cellspacing="0" bgcolor="#ffffff" style="max-width: 600px; width: 100%; background-color: #ffffff; border-radius: 12px; border: 1px solid #e2e8f0; overflow: hidden; box-shadow: 0 4px 12px -2px rgba(0, 0, 0, 0.05);">
          
          <!-- Header Section -->
          <tr>
            <td class="content-pad" style="padding: 36px 32px 24px 32px; text-align: center; border-bottom: 1px solid #f1f5f9;">
              
              <!-- Brand Logo Image (hosted on GitHub raw CDN for 100% Gmail compatibility) -->
              <table border="0" cellpadding="0" cellspacing="0" align="center" style="margin: 0 auto 16px auto;">
                <tr>
                  <td align="center">
                    <a href="https://github.com/GhananilShirpurkar/IssueHawk" target="_blank" style="text-decoration: none;">
                      <img src="https://raw.githubusercontent.com/GhananilShirpurkar/IssueHawk/main/assets/logo.png" width="190" alt="IssueHawk" style="display: block; border: 0; outline: none; max-width: 190px; height: auto; margin: 0 auto;" />
                    </a>
                  </td>
                </tr>
              </table>

              <!-- Main Title -->
              <h1 style="margin: 0 0 6px 0; font-size: 21px; font-weight: 800; letter-spacing: -0.02em; color: #0f172a;">
                {{ title }}
              </h1>
              <p style="margin: 0; font-size: 13px; color: #64748b; line-height: 1.4;">
                Curated autonomously for <strong style="color: #334155;">{{ profile_name }}</strong>
              </p>

              <!-- Executive Stats Bar -->
              {% if issues %}
              <table border="0" cellpadding="0" cellspacing="0" width="100%" style="margin-top: 20px; background-color: #f8fafc; border-radius: 8px; border: 1px solid #e2e8f0;">
                <tr>
                  <td class="metric-cell" align="center" style="padding: 10px 8px; font-size: 12px; color: #64748b;">
                    🎯 <strong style="color: #0f172a;">{{ issues|length }}</strong> Opportunities
                  </td>
                  <td class="metric-cell" align="center" style="padding: 10px 8px; font-size: 12px; color: #64748b; border-left: 1px solid #e2e8f0; border-right: 1px solid #e2e8f0;">
                    ⚡ Level: <strong style="color: #2563eb;">{{ (profile.skill_level if profile else 'Intermediate')|capitalize }}</strong>
                  </td>
                  <td class="metric-cell" align="center" style="padding: 10px 8px; font-size: 12px; color: #64748b;">
                    🗓️ Cadence: <strong style="color: #0f172a;">{{ cadence|upper }}</strong>
                  </td>
                </tr>
              </table>
              {% endif %}

            </td>
          </tr>

          <!-- Content Section -->
          <tr>
            <td class="content-pad" style="padding: 28px 32px;">

              {% if not issues %}
              <div style="text-align: center; padding: 40px 16px;">
                <p style="font-size: 15px; font-weight: 600; color: #0f172a; margin: 0 0 6px 0;">No new opportunities found today</p>
                <p style="font-size: 13px; color: #64748b; margin: 0;">All currently open issues were either scored below your relevance threshold or previously triaged.</p>
              </div>
              {% else %}

                <!-- #1 HERO / FEATURED ISSUE -->
                {% set hero = issues[0] %}
                <table width="100%" border="0" cellpadding="0" cellspacing="0" bgcolor="#f8fafc" style="background-color: #f8fafc; border-radius: 10px; border: 1px solid #cbd5e1; margin-bottom: 28px; box-shadow: 0 2px 6px rgba(0, 0, 0, 0.03);">
                  <tr>
                    <td style="padding: 22px;">

                      <!-- Eyebrow Row -->
                      <table width="100%" border="0" cellpadding="0" cellspacing="0" style="margin-bottom: 12px;">
                        <tr>
                          <td>
                            <span style="font-family: ui-monospace, SFMono-Regular, monospace; font-size: 11px; font-weight: 700; color: #1d4ed8; background-color: #eff6ff; border: 1px solid #bfdbfe; padding: 3px 8px; border-radius: 4px; letter-spacing: 0.04em;">
                              ★ TOP OPPORTUNITY
                            </span>
                          </td>
                          <td align="right">
                            <span style="font-family: ui-monospace, SFMono-Regular, monospace; font-size: 12px; font-weight: 800; color: #15803d; background-color: #f0fdf4; border: 1px solid #bbf7d0; padding: 3px 9px; border-radius: 4px;">
                              {{ hero.score }}/10 Match
                            </span>
                          </td>
                        </tr>
                      </table>

                      <!-- Issue Title -->
                      <h2 style="margin: 0 0 10px 0; font-size: 17px; font-weight: 700; line-height: 1.4;">
                        <a href="{{ hero.url }}" target="_blank" style="color: #0f172a; text-decoration: none;">
                          {{ hero.title }}
                        </a>
                      </h2>

                      <!-- Repo Tag & Difficulty -->
                      <div style="font-size: 12px; color: #64748b; margin-bottom: 12px;">
                        <span style="font-family: ui-monospace, SFMono-Regular, monospace; color: #334155; background-color: #ffffff; padding: 2px 7px; border-radius: 4px; border: 1px solid #e2e8f0;">
                          📁 {{ hero.repo }}
                        </span>
                        {% if hero.difficulty %}
                        <span style="margin-left: 6px; font-family: ui-monospace, SFMono-Regular, monospace; font-size: 11px; color: #64748b;">
                          • {{ hero.difficulty|capitalize }}
                        </span>
                        {% endif %}
                      </div>

                      <!-- Why it fits -->
                      <p style="margin: 0 0 14px 0; font-size: 13px; color: #334155; line-height: 1.5;">
                        <strong style="color: #0f172a;">Why:</strong> {{ hero.explanation }}
                      </p>

                      <!-- Tactical Implementation Hint -->
                      {% if hero.implementation_hint %}
                      <div style="border-left: 3px solid #2563eb; background-color: #ffffff; padding: 10px 12px; border-radius: 0 6px 6px 0; border: 1px solid #e2e8f0; border-left-width: 3px; font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 12px; line-height: 1.5; color: #1e293b; margin-bottom: 16px;">
                        <strong style="color: #2563eb;">tactic:</strong> {{ hero.implementation_hint }}
                      </div>
                      {% endif %}

                      <!-- Action Button -->
                      <table border="0" cellpadding="0" cellspacing="0">
                        <tr>
                          <td align="center" bgcolor="#0f172a" style="border-radius: 6px;">
                            <a href="{{ hero.url }}" target="_blank" style="display: inline-block; padding: 9px 18px; font-size: 13px; font-weight: 600; color: #ffffff; text-decoration: none; border-radius: 6px;">
                              View Issue on GitHub &rarr;
                            </a>
                          </td>
                        </tr>
                      </table>

                    </td>
                  </tr>
                </table>

                <!-- SECTION DIVIDER FOR REMAINING ISSUES -->
                {% if issues|length > 1 %}
                <table width="100%" border="0" cellpadding="0" cellspacing="0" style="margin: 28px 0 14px 0; border-top: 1px solid #e2e8f0;">
                  <tr>
                    <td style="padding-top: 18px; font-family: ui-monospace, SFMono-Regular, monospace; font-size: 11px; font-weight: 700; letter-spacing: 0.1em; color: #94a3b8; text-transform: uppercase;">
                      ADDITIONAL MATCHES ({{ issues|length - 1 }})
                    </td>
                  </tr>
                </table>

                <!-- REMAINING ISSUES (#2..N) -->
                {% for issue in issues[1:] %}
                <table width="100%" border="0" cellpadding="0" cellspacing="0" bgcolor="#ffffff" style="background-color: #ffffff; border-radius: 8px; border: 1px solid #e2e8f0; margin-bottom: 16px;">
                  <tr>
                    <td style="padding: 16px 18px;">

                      <!-- Header: Title and Score -->
                      <table width="100%" border="0" cellpadding="0" cellspacing="0" style="margin-bottom: 8px;">
                        <tr>
                          <td style="vertical-align: top;">
                            <h3 style="margin: 0; font-size: 15px; font-weight: 700; line-height: 1.4;">
                              <span style="font-family: ui-monospace, monospace; color: #2563eb; font-size: 12px; margin-right: 4px;">#{{ loop.index + 1 }}</span>
                              <a href="{{ issue.url }}" target="_blank" style="color: #0f172a; text-decoration: none;">
                                {{ issue.title }}
                              </a>
                            </h3>
                          </td>
                          <td align="right" style="vertical-align: top; padding-left: 12px; white-space: nowrap;">
                            <span style="font-family: ui-monospace, SFMono-Regular, monospace; font-size: 11px; font-weight: 700; color: #475569; background-color: #f1f5f9; border: 1px solid #e2e8f0; padding: 2px 7px; border-radius: 4px;">
                              {{ issue.score }}/10
                            </span>
                          </td>
                        </tr>
                      </table>

                      <!-- Meta: Repo -->
                      <div style="font-size: 12px; color: #64748b; margin-bottom: 10px;">
                        <span style="font-family: ui-monospace, SFMono-Regular, monospace; color: #475569; background-color: #f8fafc; padding: 2px 6px; border-radius: 4px; border: 1px solid #e2e8f0;">
                          📁 {{ issue.repo }}
                        </span>
                        {% if issue.difficulty %}
                        <span style="margin-left: 4px; font-family: ui-monospace, SFMono-Regular, monospace; font-size: 11px; color: #64748b;">
                          • {{ issue.difficulty }}
                        </span>
                        {% endif %}
                      </div>

                      <!-- Why it fits -->
                      <p style="margin: 0 0 10px 0; font-size: 13px; color: #475569; line-height: 1.4;">
                        {{ issue.explanation }}
                      </p>

                      <!-- Tactical Hint -->
                      {% if issue.implementation_hint %}
                      <div style="border-left: 2px solid #94a3b8; background-color: #f8fafc; padding: 8px 10px; border-radius: 0 4px 4px 0; font-family: ui-monospace, SFMono-Regular, monospace; font-size: 11px; line-height: 1.4; color: #334155; margin-bottom: 12px;">
                        <strong style="color: #475569;">tactic:</strong> {{ issue.implementation_hint }}
                      </div>
                      {% endif %}

                      <!-- Action Link -->
                      <div>
                        <a href="{{ issue.url }}" target="_blank" style="font-size: 12px; font-weight: 600; color: #2563eb; text-decoration: none;">
                          View Issue &rarr;
                        </a>
                      </div>

                    </td>
                  </tr>
                </table>
                {% endfor %}
                {% endif %}

              {% endif %}

            </td>
          </tr>

          <!-- Footer -->
          <tr>
            <td style="padding: 24px; background-color: #f8fafc; border-top: 1px solid #e2e8f0; text-align: center;">
              <p style="margin: 0 0 4px 0; font-size: 12px; color: #64748b;">
                Sent by <strong style="color: #0f172a;">IssueHawk</strong> • Autonomous GitHub Issue Intelligence
              </p>
              <p style="margin: 0; font-size: 11px; color: #94a3b8;">
                Target stacks: {{ (profile.skills if profile else [])|join(', ') }}
              </p>
            </td>
          </tr>

        </table>

      </td>
    </tr>
  </table>

</body>
</html>
